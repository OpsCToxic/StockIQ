# Copy to .env and fill in. .env is git-ignored and blocked from Claude edits.

# --- Infra ---
POSTGRES_USER=stockiq
POSTGRES_PASSWORD=
POSTGRES_DB=stockiq
# The app builds the database URL from POSTGRES_* plus these:
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
REDIS_URL=redis://localhost:6379/0
MINIO_ROOT_USER=stockiq
MINIO_ROOT_PASSWORD=
S3_ENDPOINT=http://localhost:9000
S3_BUCKET_RAW=stockiq-raw

# --- SEC EDGAR (required: descriptive User-Agent with contact email) ---
SEC_USER_AGENT="StockIQ personal research your-email@example.com"

# --- LLM ---
ANTHROPIC_API_KEY=
EXPLANATION_MODEL=
CLASSIFICATION_MODEL=

# --- Market data / news (provider TBD, see docs/decisions) ---
MARKET_DATA_PROVIDER=
MARKET_DATA_API_KEY=
NEWS_API_KEY=

# --- Brokerage aggregator (TBD; read-only scopes only) ---
BROKERAGE_PROVIDER=
BROKERAGE_CLIENT_ID=
BROKERAGE_CLIENT_SECRET=

# --- Social ---
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT="stockiq/0.1 by your-reddit-username"
STOCKTWITS_TOKEN=

# --- Alerts delivery ---
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_URL=
